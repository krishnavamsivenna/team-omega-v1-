# OMEGA Backend Environment Configuration
PROJECT_NAME="OMEGA - AI Job Application & Interview Coach"
API_V1_STR="/api"

# Database Configuration
# Default target is PostgreSQL. If PostgreSQL is not reachable, the system falls back to SQLite for dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omega_db"

# Security / JWT
JWT_SECRET="omega_super_secret_jwt_key_level1_mvp_2026_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upload directory
UPLOAD_DIR="./uploads"

# ==========================================
# AI Provider Configuration (Level 2)
# ==========================================
# Provider choice: "gemini", "openai", "ollama", or "baseline"
# If external LLMs fail or keys are absent, AIService automatically falls back to "baseline".
AI_PROVIDER="baseline"

# Option A: Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Option B: OpenAI / OpenAI-compatible (Groq, OpenRouter, etc.)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"

# Option C: Local Ollama
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Request Timeout
AI_TIMEOUT_SECONDS=45
